<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Every minute: reattach any phone that dropped off, replay its shell login,
     and let ghost refresh its `phones` table.
     Replace OPERATOR with the operator account's short name before installing. -->
<plist version="1.0">
<dict>
  <key>Label</key>                 <string>ai.ofmai.farm.adb-connect</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>scripts/farm_adb_connect.sh</string>
  </array>
  <key>WorkingDirectory</key>      <string>/Users/OPERATOR/ofmai-farm</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key>          <string>.</string>
    <key>PATH</key>                <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>             <true/>
  <key>StartInterval</key>         <integer>60</integer>
  <key>StandardOutPath</key>       <string>/Users/OPERATOR/Library/Logs/ofmai-farm/adb-connect.log</string>
  <key>StandardErrorPath</key>     <string>/Users/OPERATOR/Library/Logs/ofmai-farm/adb-connect.log</string>
</dict>
</plist>
